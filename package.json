{
  "name": "mypets-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:seed": "psql \"$DIRECT_URL\" -v ON_ERROR_STOP=1 -f supabase/seed.sql"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.11.1",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.1",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prisma": "^6.11.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
