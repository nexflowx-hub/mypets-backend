APP_ENV=production
APP_VERSION=0.9.0
HOST=0.0.0.0
PORT=8081

# Supabase PostgreSQL. On the VPS prefer the Supabase Session Pooler (5432).
DATABASE_URL=
DIRECT_URL=

# Supabase Auth verification. Publishable key is preferred; legacy anon key is accepted as fallback.
# Do not use the service-role key for normal JWT verification.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

CORS_ORIGINS=https://mypets.lat,https://www.mypets.lat
PUBLIC_SITE_URL=https://mypets.lat

# Production should keep demo records private. If no live story exists, the API uses the clearly labelled editorial demo catalog as fallback.
PUBLIC_DEMO_CONTENT=false

# Private server-to-server token for the public-web discovery ingestion worker.
# Generate a long random value on the VPS; never expose it in frontend code.
DISCOVERY_INGEST_TOKEN=

# Server-side allowlist used only to bootstrap human admin access.
# Use the email(s) of authenticated MyPets accounts. Never expose this as NEXT_PUBLIC_*.
ADMIN_EMAILS=

# Payments — XPAYMENTS credentials are server-side only.
# Production routing is currency-scoped and should use dedicated live Stores:
#   EUR -> MYPETS-EUR
#   BRL -> MYPETS-BRL
# Keep PAYMENTS_LIVE=false until the intended live mode has been reviewed.
# Strict/default mode requires the matching Merchant webhook signing secret.
# Temporary degraded launch mode can be explicitly enabled with
# XPAYMENTS_ALLOW_WEBHOOKLESS_LIVE=true. In that mode payments may be created,
# but webhook delivery is unavailable and Native S2S payments can remain locally
# PENDING until operational/manual reconciliation is completed.
PAYMENT_PROVIDER=xpayments
PAYMENTS_LIVE=false
PAYOUTS_ENABLED=false
XPAYMENTS_ALLOW_WEBHOOKLESS_LIVE=false
XPAYMENTS_API_BASE=https://api.xpayments.digital/api/v1
XPAYMENTS_CHECKOUT_BASE=https://checkout.xpayments.digital
XPAYMENTS_STORE_CODE_EUR=MYPETS-EUR
XPAYMENTS_API_KEY_EUR=
XPAYMENTS_WEBHOOK_SECRET_EUR=
XPAYMENTS_STORE_CODE_BRL=MYPETS-BRL
XPAYMENTS_API_KEY_BRL=
XPAYMENTS_WEBHOOK_SECRET_BRL=

# Native S2S methods are explicit allowlists; an empty value exposes no direct method.
# BRL: pix
# EUR: mb_way,multibanco,bizum
XPAYMENTS_NATIVE_METHODS_BRL=
XPAYMENTS_NATIVE_METHODS_EUR=

# Persistent sandbox lane. These values must never be used for public checkout.
# Recommended Store: HUMANIMPACT-XPAY-SANDBOX
# Configure its webhook to:
# https://api.mypets.lat/v1/payments/webhooks/xpayments-sandbox
XPAYMENTS_SANDBOX_STORE_CODE=HUMANIMPACT-XPAY-SANDBOX
XPAYMENTS_SANDBOX_API_KEY=
XPAYMENTS_SANDBOX_WEBHOOK_SECRET=

LOG_LEVEL=info
